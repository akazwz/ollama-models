{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"types": ["node"],
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"isolatedModules": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": [
		"src/**/*.ts",
		"test/**/*.ts",
		"scripts/**/*.ts",
		"cloudflare.config.ts",
		".cloudflare/types"
	]
}
